# ── Google OAuth ──────────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# After running `node src/auth.js` this gets populated automatically
GOOGLE_REFRESH_TOKEN=

# Your Gmail address (used to send outreach + as "me" for API calls)
GMAIL_ADDRESS=

# ── Slack ─────────────────────────────────────────────────────────────────────
# From api.slack.com → Your App → OAuth & Permissions → Bot Token
SLACK_BOT_TOKEN=
# Your personal Slack Member ID (right-click your name → Copy member ID)
SLACK_USER_ID=

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Exchange rate (optional override — otherwise fetched live) ─────────────────
# DKK_TO_USD_OVERRIDE=0.145

# ── Wedding config ─────────────────────────────────────────────────────────────
GMAIL_LABEL=wedding
GUEST_COUNT_MIN=100
GUEST_COUNT_MAX=125
BUDGET_DKK=600000
BUDGET_USD=85000
